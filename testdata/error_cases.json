    "body": "{\"msg\":\"boom\",\"request_id\":\"body-id\"}",
    "expect": {
      "ok": false,
      "class": "OctenServerError",
      "code": null,
      "message": "boom",
      "requestId": "header-id"
    }
  },
  {
    "name": "request id from body",
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"msg\":\"boom\",\"request_id\":\"body-id\"}",
    "expect": {
      "ok": false,
      "class": "OctenServerError",
      "code": null,
      "message": "boom",
      "requestId": "body-id"
    }
  },
  {
    "name": "no request id",
    "status": 500,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"msg\":\"boom\"}",
    "expect": {
      "ok": false,
      "class": "OctenServerError",
      "code": null,
      "message": "boom",
      "requestId": null
    }
  },
  {
    "name": "2xx failure request id from body",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":1001,\"msg\":\"bad\",\"request_id\":\"abc\"}",
    "expect": {
      "ok": false,
      "class": "OctenAPIError",
      "code": 1001,
      "message": "bad",
      "requestId": "abc"
    }
  },
  {
    "name": "empty x-request-id header falls back to body request_id",
    "status": 500,
    "headers": {
      "content-type": "application/json",
