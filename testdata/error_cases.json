  {
    "name": "empty msg falls through to message",
    "status": 400,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"msg\":\"\",\"message\":\"second\"}",
    "expect": {
      "ok": false,
      "class": "OctenBadRequestError",
      "code": null,
      "message": "second"
