[
  {
    "name": "200 code null is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":null,\"results\":[]}",
    "expect": {
      "ok": true
    }
  },
  {
    "name": "200 code string zero is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":\"0\",\"results\":[]}",
    "expect": {
      "ok": true
    }
  },
  {
    "name": "200 code true is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":true,\"results\":[]}",
    "expect": {
      "ok": true
    }
  },
  {
    "name": "200 code missing is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"results\":[]}",
    "expect": {
      "ok": true
    }
  },
  {
    "name": "200 code 0 with msg is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":0,\"msg\":\"success\",\"results\":[]}",
    "expect": {
      "ok": true
    }
  },
  {
    "name": "200 code string non-numeric is success",
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"code\":\"abc\",\"results\":[]}",
    "expect": {
      "ok": true
