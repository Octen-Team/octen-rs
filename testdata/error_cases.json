  {
    "name": "429 with Retry-After 5",
    "status": 429,
    "headers": {
      "content-type": "application/json",
      "retry-after": "5"
    },
    "body": "{\"msg\":\"slow down\"}",
    "expect": {
      "ok": false,
      "class": "OctenRateLimitError",
      "code": null,
      "message": "slow down",
      "retryAfter": 5
    }
  },
  {
    "name": "429 without Retry-After",
    "status": 429,
    "headers": {
      "content-type": "application/json"
    },
