  {
    "name": "msg wins over message",
    "status": 400,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"message\":\"second\",\"msg\":\"first\"}",
    "expect": {
      "ok": false,
      "class": "OctenBadRequestError",
      "code": null,
      "message": "first"
